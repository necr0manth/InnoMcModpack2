	quest.63C7B258CA2B0B5E.title: "Выпиксен"
	quest.63FCB4188DF16262.quest_desc: ["Падает с циклопа с приличным шансом."]
	quest.63FCB4188DF16262.quest_subtitle: "Заполучите глаз циклопа"
	quest.63FCB4188DF16262.title: "Великий глаз"
